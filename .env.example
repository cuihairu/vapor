# Vapor compose environment template.
#
# Copy to `.env` next to docker-compose.yml and adjust before `docker compose up`:
#   cp .env.example .env
#
# The compose file fail-fasts on missing credential variables (no known-dev-token
# fallback), so these must be present. The values below are local-dev placeholders;
# for production set your own strong secrets and keep the `.env` out of version
# control.
VAPOR_ADMIN_API_KEY=admin-dev-token
VAPOR_AGENT_API_KEYS=agent-dev-token
VAPOR_AGENT_API_KEY=agent-dev-token

# Optional overrides (see docs/docker.md for the full table).
# VAPOR_VIEWER_API_KEY=
# VAPOR_AGENT_ID=agent-1
# VAPOR_AGENT_REGION=eu-west
# VAPOR_CONTROLPLANE_PORT=8080
# VAPOR_AGENT_METRICS_PORT=9700
