# .NET
bin/
obj/
.vs/
*.user
*.suo
*.cache
*.nupkg
TestResults/
**/TestResults/
# coverlet.collector can drop <guid>/coverage.cobertura.xml directly under
# tests/ depending on how dotnet test is invoked; these are always artifacts.
tests/*/coverage.cobertura.xml

# Runtime data
data/
.claude/worktrees/
coverage/

# Docs site mirror built by .github/workflows/docs.yml from tests/TESTING.md
docs/testing.md

# Local mkdocs build output (CI builds to _site, see .github/workflows/docs.yml)
site/

# Bytecode caches from the python scripts under scripts/
__pycache__/

# 2026-10-17: 依赖目录，禁止任何操作（含 git mv / glob 展开）
node_modules/
**/node_modules/
.pnpm-store/
