<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Steam protocol values are culture-insensitive by design; match the
         ControlPlane baseline so library code never sees a localized culture. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vapor.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vapor.Protocol\Vapor.Protocol.csproj" />
    <ProjectReference Include="..\Vapor.Steam.Core\Vapor.Steam.Core.csproj" />
    <ProjectReference Include="..\Vapor.Plugins.Core\Vapor.Plugins.Core.csproj" />
  </ItemGroup>
</Project>


