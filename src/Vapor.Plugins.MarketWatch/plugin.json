{
  "id": "vapor.market-watch",
  "name": "Vapor Market Watch",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "description": "Price threshold watch: background polling of store prices with log and webhook alerts.",
  "trust": "official",
  "permissions": [
    "actions"
  ],
  "resources": ["network"],
  "entryAssembly": "Vapor.Plugins.MarketWatch.dll",
  "entryType": "Vapor.Plugins.MarketWatch.MarketWatchPlugin",
  "configuration": {
    "market.check_interval_seconds": "300",
    "market.threshold_percent": "10",
    "market.country": "us",
    "market.webhook_url": ""
  },
  "configurationSchema": {
    "market.check_interval_seconds": { "type": "int", "min": 10, "max": 86400 },
    "market.threshold_percent": { "type": "decimal", "min": 0.01, "max": 10000 },
    "market.country": { "type": "string" },
    "market.webhook_url": { "type": "string" }
  }
}
